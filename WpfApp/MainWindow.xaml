<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="450">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Логин:" Margin="0,0,0,2"/>
        <TextBox x:Name="TbLogin" Grid.Row="0" Margin="0,20,0,10"
                 TextChanged="TbLogin_TextChanged"/>

        <TextBlock Grid.Row="1" Text="Пароль:" Margin="0,0,0,2"/>
        <PasswordBox Grid.Row="1" x:Name="PbPassword" Margin="0,20,0,10"
                 PasswordChanged="PbPassword_PasswordChanged"/>

        <TextBlock Grid.Row="2" Text="Подтверждение пароля:" Margin="0,0,0,2"/>
        <PasswordBox Grid.Row="2" x:Name="PbConfirm" Margin="0,20,0,10"
                 PasswordChanged="PbConfirm_PasswordChanged"/>

        <TextBlock Grid.Row="3" Text="Email:" Margin="0,0,0,2"/>
        <TextBox Grid.Row="3" x:Name="TbEmail" Margin="0,20,0,10"
                 TextChanged="TbEmail_TextChanged"/>

        <TextBlock Grid.Row="4" x:Name="TbError"
                   TextWrapping="Wrap" Margin="0,0,0,2"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="BtnRegister" Content="Зарегистрироваться"
                    Width="150" Height="30" Margin="0,0,10,0"
                    Click="BtnRegister_Click"/>
            <Button x:Name="BtnClear" Content="Очистить"
                    Width="100" Height="30" Click="BtnClear_Click"/>

        </StackPanel>
    </Grid>
</Window>
